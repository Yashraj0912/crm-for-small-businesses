# ---- Required
# Neon: use the POOLED connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# 32+ random characters. Never commit the real value.
JWT_SECRET=
TOKEN_TTL_MINUTES=720
# Set to false after the business owner has registered
ALLOW_REGISTRATION=true

# ---- Email notifications via Gmail (optional)
# Turn on 2-Step Verification on the Gmail account, then create an "App password" and paste it here.
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=
# Public URL of your app for links in emails (defaults to your Vercel production URL)
APP_URL=

# ---- AI assistant (optional): use ONE of the two options
# Option A: any OpenAI-compatible provider (Google Gemini, Groq, OpenRouter, OpenAI...)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=
# Option B: Anthropic
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=50
