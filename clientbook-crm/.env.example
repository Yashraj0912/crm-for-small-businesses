# Neon: use the POOLED connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# 32+ random characters. Never commit the real value.
JWT_SECRET=
TOKEN_TTL_MINUTES=720
# Set to false after the business owner has registered
ALLOW_REGISTRATION=true
# Only needed if the frontend is hosted on a different domain (comma separated)
CORS_ORIGINS=
